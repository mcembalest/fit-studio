{
  "$schema": "node_modules/wrangler/config-schema.json",
  // No hyphen: this is what puts the app on fitstudio.macembalest.workers.dev.
  "name": "fitstudio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything else is served from the built frontend in ./dist.
    "run_worker_first": ["/api/*", "/img/*"]
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "fit-studio"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fit-studio",
      "database_id": "de5e6bc7-8767-44cd-8838-f1aed0af08d3"
    }
  ],
  // Generation runs here, not in the request that asks for it: a generation
  // takes 20-55s and ctx.waitUntil() is cancelled at 30s, so background work
  // needs an alarm's 15 minute budget. Note this `migrations` key is wrangler's
  // Durable Object class registry — unrelated to the SQL in ./migrations.
  "durable_objects": {
    "bindings": [{ "name": "JOBS", "class_name": "GenerationJob" }]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GenerationJob"]
    }
  ],
  "vars": {
    // Her are.na channel — the closet. Swap the slug to point at another one.
    "ARENA_CHANNEL": "to-sew-rqyybrm3cee"
  },
  "observability": {
    "enabled": true
  }
  // OPENAI_API_KEY is a secret: `npx wrangler secret put OPENAI_API_KEY`.
  // In local dev it is read from .dev.vars (see .dev.vars.example).
}
